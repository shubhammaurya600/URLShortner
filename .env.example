# ─────────────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/url_shortener
DATABASE_REPLICA_URL=postgres://postgres:password@localhost:5432/url_shortener

# ─────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ─────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CLICK_EVENTS=url_click_events
KAFKA_CONSUMER_GROUP=click_analytics_group

# ─────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────
BASE_URL=http://localhost:8000
SHORT_CODE_LENGTH=7
MAX_COLLISION_RETRIES=5

# ─────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────
THROTTLE_SHORTEN_RATE=100/min
THROTTLE_REDIRECT_RATE=1000/min

# ─────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────
LOG_LEVEL=INFO
